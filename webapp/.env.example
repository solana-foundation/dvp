# Keyed devnet RPC endpoint. Server-only — proxied to the browser via /api/rpc
# so the key never reaches the client.
RPC_URL=https://api.devnet.solana.com/<your-key>

# Demo treasury keypair as a JSON byte array (the contents of a
# `solana-keygen new` file). Server-only secret: it funds the ephemeral role
# wallets and is mint authority for the two demo tokens. Never commit the real
# value; for deploys use the platform's encrypted secret upload.
DEMO_TREASURY_SECRET=[12,34,56, ...]
